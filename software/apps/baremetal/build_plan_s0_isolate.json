{
  "make_cwd": ".",
  "out_dir": "../../bin/apps/baremetal",
  "gendata_params": "../../data/gendata_params.hjson",
  "//": "2x2 factorial isolating why the W1-tile workload is 13-17 points slower than a plain GEMM on identical S0 hardware. A = row-parallel mapping at the long contraction (N=4096). B = 2-D tiled mapping at the short one (N=512). The other two corners are already measured.",
  "rename_tag_rules": {
    "rm_gemm_f16":     ["matrix_M", "matrix_N", "matrix_P"],
    "rm_gemm_opt_f16": ["matrix_M", "matrix_N", "matrix_P"]
  },
  "extra_args": {
    "rm_gemm_f16":     "COMPILER=llvm",
    "rm_gemm_opt_f16": "COMPILER=llvm"
  },
  "configs": [
    {
      "name": "dse_s0_m4",
      "pack_dir": "stage1_dse/rm_gemm_s0_isolate",
      "apps": {
        "rm_gemm_f16": {
          "tasks": [ {"matrix_M": 512, "matrix_N": 4096, "matrix_P": 256} ],
          "variants": {"_parN4096": "-DPARALLEL"}
        },
        "rm_gemm_opt_f16": {
          "tasks": [ {"matrix_M": 512, "matrix_N": 512, "matrix_P": 512,
                      "LLM_PERF_ONLY": 1, "RM_GEMM_TILED_2D": 1,
                      "NE_R": 4, "NE_C": 4, "ROW_TILE": 512, "COL_TILE": 512} ],
          "variants": {"_tiledN512": ""}
        }
      }
    }
  ]
}
