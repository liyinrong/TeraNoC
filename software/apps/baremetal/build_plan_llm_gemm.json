{
  "make_cwd": ".",
  "out_dir": "../../bin/apps/baremetal",
  "gendata_params": "../../data/gendata_params.hjson",

  "//": "Pure-GEMM dense-LLM pack plus the stage-1 FFN DSE. Toy tasks are golden-checked; surrogate/full tasks use uninitialized L2 data and report cycles only. The 2-D mapping keys are data-generation parameters as well as C defines, so packed operand layouts cannot disagree with the selected kernel path.",

  "rename_tag_rules": {
    "llm_gemm_ffn_f16": ["S", "D", "I"],
    "llm_gemm_attention_f16": ["S", "D", "N_HEADS", "HEAD_DIM"]
  },

  "extra_args": {
    "llm_gemm_ffn_f16": "COMPILER=llvm",
    "llm_gemm_attention_f16": "COMPILER=llvm"
  },

  "configs": [
    {
      "name": "tensorpool256_spatz4",
      "pack_dir": "tensorpool256_spatz4/gemm_toy",
      "apps": {
        "llm_gemm_ffn_f16": [
          {"S": 512, "D": 256, "I": 1024, "LLM_PERF_ONLY": 0}
        ],
        "llm_gemm_attention_f16": [
          {"S": 512, "D": 256, "N_HEADS": 8, "HEAD_DIM": 32,
           "LLM_PERF_ONLY": 0}
        ]
      }
    },
    {
      "name": "tensorpool256_spatz4",
      "pack_dir": "tensorpool256_spatz4/gemm_real",
      "apps": {
        "llm_gemm_ffn_f16": [
          {"S": 2048, "D": 4096, "I": 16384, "LLM_PERF_ONLY": 1}
        ],
        "llm_gemm_attention_f16": [
          {"S": 2048, "D": 4096, "N_HEADS": 32, "HEAD_DIM": 128,
           "LLM_PERF_ONLY": 1}
        ]
      }
    }
  ]
}
