{
  "make_cwd": ".",
  "out_dir": "../../bin/apps/baremetal",
  "gendata_params": "../../data/gendata_params.hjson",
  "//": "Exercises the newly implemented w_col_off (MCFIG1[31:16]). Each engine starts its output-column walk at a different column tile and wraps, so the engines sharing a W panel do not all begin on the same L1 tile after the barrier.",
  "rename_tag_rules": { "rm_gemm_opt_f16": ["matrix_M", "matrix_N", "matrix_P"] },
  "extra_args": { "rm_gemm_opt_f16": "COMPILER=llvm" },
  "configs": [
    {
      "name": "dse_s0_m4",
      "pack_dir": "stage1_dse/rm_gemm_s0_wcolshift",
      "apps": {
        "rm_gemm_opt_f16": {
          "tasks": [
            {"matrix_M": 256, "matrix_N": 4096, "matrix_P": 512,
             "LLM_PERF_ONLY": 1, "RM_GEMM_TILED_2D": 1,
             "NE_R": 4, "NE_C": 4, "ROW_TILE": 256, "COL_TILE": 512}
          ],
          "variants": {"_wcol": "-DWCOLSHIFT=1"}
        }
      }
    }
  ]
}
