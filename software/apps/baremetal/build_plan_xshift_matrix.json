{
  "make_cwd": ".",
  "out_dir": "../../bin/apps/baremetal",
  "gendata_params": "../../data/gendata_params.hjson",
  "//": "Optimized W1-tile kernels for the DSE matrix: rm_gemm_xshift_f16 with the RedMulE contraction-start offset. Geometry params mirror build_plan_rm_gemm_w1_tile.json exactly, so cells are comparable to the previous matrix apart from the shift. S3 shares S2's ELF (same PORT_WIDTH).",
  "rename_tag_rules": { "rm_gemm_xshift_f16": ["matrix_M", "matrix_N", "matrix_P"] },
  "extra_args": { "rm_gemm_xshift_f16": "COMPILER=llvm" },
  "configs": [
    {
      "name": "dse_s0_m4",
      "pack_dir": "stage1_dse/xshift_w1_s0",
      "apps": { "rm_gemm_xshift_f16": {
        "tasks": [ {"matrix_M": 256, "matrix_N": 4096, "matrix_P": 512, "LLM_PERF_ONLY": 1,
                    "RM_GEMM_TILED_2D": 1, "NE_R": 4, "NE_C": 4, "ROW_TILE": 256, "COL_TILE": 512} ],
        "variants": {"_off": "-DRM_X_SHIFT=0 -DRM_W_SHIFT=0", "_on": "-DRM_X_SHIFT=1 -DRM_W_SHIFT=0"} } }
    },
    {
      "name": "dse_s1_m4",
      "pack_dir": "stage1_dse/xshift_w1_s1",
      "apps": { "rm_gemm_xshift_f16": {
        "tasks": [ {"matrix_M": 512, "matrix_N": 4096, "matrix_P": 1024, "LLM_PERF_ONLY": 1,
                    "RM_GEMM_TILED_2D": 1, "NE_R": 8, "NE_C": 8, "ROW_TILE": 512, "COL_TILE": 1024} ],
        "variants": {"_off": "-DRM_X_SHIFT=0 -DRM_W_SHIFT=0", "_on": "-DRM_X_SHIFT=1 -DRM_W_SHIFT=0"} } }
    },
    {
      "name": "dse_s2_m4",
      "pack_dir": "stage1_dse/xshift_w1_s2",
      "apps": { "rm_gemm_xshift_f16": {
        "tasks": [ {"matrix_M": 512, "matrix_N": 4096, "matrix_P": 1024, "LLM_PERF_ONLY": 1,
                    "RM_GEMM_TILED_2D": 1, "NE_R": 8, "NE_C": 8, "ROW_TILE": 512, "COL_TILE": 1024} ],
        "variants": {"_off": "-DRM_X_SHIFT=0 -DRM_W_SHIFT=0", "_on": "-DRM_X_SHIFT=1 -DRM_W_SHIFT=0"} } }
    }
  ]
}
