{
  "make_cwd": ".",
  "out_dir": "../../bin/apps/baremetal",
  "gendata_params": "../../data/gendata_params.hjson",

  "//": "Single-GEMM stage-1 DSE pack. S0 has a distinct 16-engine checked toy. S1 guests build once against dse_s1_m4 and are reused unchanged on M1-M5 because only the wide-plane channel mix differs. S2 has a distinct ELF because REDMULE_H and PORT_WIDTH are compile-time geometry. Do not build timing-only guest variants: functional/timing GVSoC A/B runs must name the same geometry-matched ELF and archive one SHA-256. Toys carry goldens; surrogate/full tasks reserve uninitialized L2 arrays and skip only DPI checking.",

  "rename_tag_rules": {
    "rm_gemm_opt_f16": ["matrix_M", "matrix_N", "matrix_P"]
  },

  "extra_args": {
    "rm_gemm_opt_f16": "COMPILER=llvm"
  },

  "configs": [
    {
      "name": "dse_s0_m4",
      "pack_dir": "stage1_dse/rm_gemm_s0_m4",
      "apps": {
        "rm_gemm_opt_f16": {
          "variants": {
            "_tiled_toy": {
              "tasks": [
                {"matrix_M": 256, "matrix_N": 256, "matrix_P": 512,
                 "LLM_PERF_ONLY": 0, "RM_GEMM_TILED_2D": 1,
                 "NE_R": 4, "NE_C": 4,
                 "ROW_TILE": 256, "COL_TILE": 512}
              ]
            }
          }
        }
      }
    },
    {
      "name": "dse_s1_m4",
      "pack_dir": "stage1_dse/rm_gemm_s1_common",
      "apps": {
        "rm_gemm_opt_f16": {
          "variants": {
            "_tiled_toy": {
              "tasks": [
                {"matrix_M": 512, "matrix_N": 256, "matrix_P": 1024,
                 "LLM_PERF_ONLY": 0, "RM_GEMM_TILED_2D": 1,
                 "NE_R": 8, "NE_C": 8,
                 "ROW_TILE": 512, "COL_TILE": 1024}
              ]
            },
            "_tiled_surrogate": {
              "tasks": [
                {"matrix_M": 2048, "matrix_N": 4096, "matrix_P": 2048,
                 "LLM_PERF_ONLY": 1, "RM_GEMM_TILED_2D": 1,
                 "NE_R": 8, "NE_C": 8,
                 "ROW_TILE": 512, "COL_TILE": 1024}
              ]
            },
            "_tiled_full": {
              "tasks": [
                {"matrix_M": 2048, "matrix_N": 4096, "matrix_P": 16384,
                 "LLM_PERF_ONLY": 1, "RM_GEMM_TILED_2D": 1,
                 "NE_R": 8, "NE_C": 8,
                 "ROW_TILE": 512, "COL_TILE": 1024}
              ]
            }
          }
        }
      }
    },
    {
      "name": "dse_s2_m4",
      "pack_dir": "stage1_dse/rm_gemm_s2_m4",
      "apps": {
        "rm_gemm_opt_f16": {
          "variants": {
            "_tiled_toy": {
              "tasks": [
                {"matrix_M": 512, "matrix_N": 256, "matrix_P": 1024,
                 "LLM_PERF_ONLY": 0, "RM_GEMM_TILED_2D": 1,
                 "NE_R": 8, "NE_C": 8,
                 "ROW_TILE": 512, "COL_TILE": 1024}
              ]
            },
            "_tiled_surrogate": {
              "tasks": [
                {"matrix_M": 2048, "matrix_N": 4096, "matrix_P": 2048,
                 "LLM_PERF_ONLY": 1, "RM_GEMM_TILED_2D": 1,
                 "NE_R": 8, "NE_C": 8,
                 "ROW_TILE": 512, "COL_TILE": 1024}
              ]
            },
            "_tiled_full": {
              "tasks": [
                {"matrix_M": 2048, "matrix_N": 4096, "matrix_P": 16384,
                 "LLM_PERF_ONLY": 1, "RM_GEMM_TILED_2D": 1,
                 "NE_R": 8, "NE_C": 8,
                 "ROW_TILE": 512, "COL_TILE": 1024}
              ]
            }
          }
        }
      }
    }
  ]
}
