{
  "make_cwd": ".",
  "out_dir": "../../bin/apps/baremetal",
  "gendata_params": "../../data/gendata_params.hjson",

  "rename_tag_rules": {
    "rm_gemm_f16": ["matrix_M", "matrix_N", "matrix_P"]
  },

  "extra_args": {
    "rm_gemm_f16": "COMPILER=llvm"
  },

  "configs": [
    {
      "name": "monster_baseline",
      "pack_dir": "monster_baseline/tensor_engine",
      "apps": {
        "rm_gemm_f16": {
          "variants": {
            "": {
              "defines": "-DPARALLEL",
              "tasks": [
                {"matrix_M": 2048, "matrix_N": 128, "matrix_P": 128},
                {"matrix_M": 2048, "matrix_N": 256, "matrix_P": 128},
                {"matrix_M": 2048, "matrix_N": 256, "matrix_P": 256},
                {"matrix_M": 4096, "matrix_N": 256, "matrix_P": 128}
              ]
            },
            "_single": {
              "defines": "-DSINGLE",
              "tasks": [
                {"matrix_M": 32, "matrix_N": 128, "matrix_P": 128},
                {"matrix_M": 32, "matrix_N": 256, "matrix_P": 256}
              ]
            }
          }
        }
      }
    }
  ]
}
