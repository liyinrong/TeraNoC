     EN_REMOTE_RF  = 1 
   } en_remote_rf_e;
 
+  // Integer square root for elaboration-time sizing. $sqrt returns a real,
+  // and SpyGlass carries that real through int-typed localparams, turning the
+  // trees' integer / and % into rounded real ones (out-of-range indices).
+  function automatic int unsigned isqrt(input int unsigned n);
+    isqrt = 0;
+    for (int unsigned r = 1; r*r <= n; r++) isqrt = r;
+  endfunction
+
 endpackage: fractal_sync_pkg
