diff --git a/hardware/deps/redmule/rtl/redmule_pkg.sv b/hardware/deps/redmule/rtl/redmule_pkg.sv
index c9565f4..f5a6f45 100644
--- a/hardware/deps/redmule/rtl/redmule_pkg.sv
+++ b/hardware/deps/redmule/rtl/redmule_pkg.sv
@@ -11,7 +11,14 @@ import hci_package::*;
 import hwpe_stream_package::*;
 
 package redmule_pkg;
-  parameter int unsigned MaxDim               = 32;
+  // MaxDim sizes every control field that carries an array coordinate, so it has to
+  // cover the largest configured dimension. Upstream fixes it at 32, which silently
+  // truncates a build with Width or Height above that; TeraNoC drives the geometry
+  // from ARRAY_WIDTH/ARRAY_HEIGHT, so raise the ceiling to match when they are set.
+  localparam int unsigned CfgWidth  = `ifdef ARRAY_WIDTH `ARRAY_WIDTH `else 32 `endif;
+  localparam int unsigned CfgHeight = `ifdef ARRAY_HEIGHT `ARRAY_HEIGHT `else 32 `endif;
+  localparam int unsigned CfgMaxDim = CfgWidth > CfgHeight ? CfgWidth : CfgHeight;
+  parameter int unsigned MaxDim               = CfgMaxDim > 32 ? CfgMaxDim : 32;
   parameter int unsigned MaxPipeRegs          = 4;
   parameter int unsigned MaxDepth             = MaxDim * MaxPipeRegs;
   parameter int unsigned MaxDataW             = MaxDepth * 16;
diff --git a/hardware/deps/redmule/rtl/redmule_scheduler.sv b/hardware/deps/redmule/rtl/redmule_scheduler.sv
index 601c785..8618183 100644
--- a/hardware/deps/redmule/rtl/redmule_scheduler.sv
+++ b/hardware/deps/redmule/rtl/redmule_scheduler.sv
@@ -680,10 +680,17 @@ module redmule_scheduler
   assign y_push_counter_d = y_push_counter_q == y_push_height-1 ? '0 : y_push_counter_q + 1;
   assign y_push_clr       = y_push_en && ~stall_engine && y_push_counter_q == y_push_height-1;
 
-  assign y_width  = y_rows_iter_q == y_config_fast.w_rows_iter-1 && y_config_fast.w_rows_lftovr != '0 ? y_config_fast.w_rows_lftovr : W;
+  // y_width/z_width count Z STORE columns, i.e. the M dimension mapped onto Width,
+  // so they must clamp on the X-rows (M) leftover exactly like cntrl_x_buffer_o.width
+  // above -- NOT on the w_rows (N) leftover. y_rows_iter_q/z_rows_iter_q already wrap
+  // on x_rows_iter (see their _d assignments), so comparing them against w_rows_iter
+  // mixed two different loops. Clamping on N made the Z store stream Width columns of
+  // which only x_rows_lftovr were valid, clobbering the neighbouring tile's Z whenever
+  // m_size % Width != 0.
+  assign y_width  = y_rows_iter_q == y_config_fast.x_rows_iter-1 && y_config_fast.x_rows_lftovr != '0 ? y_config_fast.x_rows_lftovr : W;
   assign y_height = y_cols_iter_q == y_config_fast.w_cols_iter-1 && y_config_fast.w_cols_lftovr != '0 ? y_config_fast.w_cols_lftovr : D;
 
-  assign z_width_next  = z_rows_iter_q == z_config_fast.w_rows_iter-1 && z_config_fast.w_rows_lftovr != '0 ? z_config_fast.w_rows_lftovr : W;
+  assign z_width_next  = z_rows_iter_q == z_config_fast.x_rows_iter-1 && z_config_fast.x_rows_lftovr != '0 ? z_config_fast.x_rows_lftovr : W;
   assign z_height_next = z_cols_iter_q == z_config_fast.w_cols_iter-1 && z_config_fast.w_cols_lftovr != '0 ? z_config_fast.w_cols_lftovr : D;
 
   always_ff @(posedge clk_i or negedge rst_ni) begin : z_width_register
diff --git a/hardware/deps/redmule/rtl/x_buffer/redmule_x_buffer.sv b/hardware/deps/redmule/rtl/x_buffer/redmule_x_buffer.sv
index 15bd1b4..4cf9d20 100644
--- a/hardware/deps/redmule/rtl/x_buffer/redmule_x_buffer.sv
+++ b/hardware/deps/redmule/rtl/x_buffer/redmule_x_buffer.sv
@@ -271,7 +271,15 @@ always_ff @(posedge clk_i or negedge rst_ni) begin : buf_write_counter
       if ((current_state == PAD_EMPTY || current_state == FAST_FILL && ~first_block) && ctrl_i.h_shift)
         buf_write_cnt <= buf_write_cnt + 1;
       else if (ctrl_i.pad_setup)
-        buf_write_cnt <= ctrl_i.slots;
+        // Prime the double-buffer, not the job: buf_write_cnt tracks how many pad
+        // entries have been drained into the 2-row x_buffer_scm, and pad_setup
+        // pre-loads exactly two rows of H -- the same geometry first_block uses
+        // (pad_r_addr_q == 2*H-1 above). ctrl_i.slots is a JOB size
+        // (H*(NumPipeRegs+1) = TOT_DEPTH), which only equals 2*H when
+        // NumPipeRegs == 1; for any deeper array it desynchronises the FAST_FILL
+        // exit against pad_r_addr_q and every X block is assembled from the wrong
+        // pad entries (silently wrong results, unchanged cycle count).
+        buf_write_cnt <= 2*H;
     end
   end
 end
