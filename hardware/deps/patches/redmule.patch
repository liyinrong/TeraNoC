+    cntrl_streamer_o.z_stream_sink_ctrl.addressgen_ctrl.d0_len = num_x_reads;
     cntrl_streamer_o.z_stream_sink_ctrl.addressgen_ctrl.d0_stride = z_config.yz_d0_stride;
