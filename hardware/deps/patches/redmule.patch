diff --git a/hardware/deps/redmule/rtl/redmule_tiler.sv b/hardware/deps/redmule/rtl/redmule_tiler.sv
index 44f9843..3f46161 100644
--- a/hardware/deps/redmule/rtl/redmule_tiler.sv
+++ b/hardware/deps/redmule/rtl/redmule_tiler.sv
@@ -302,7 +302,11 @@ assign config_d.x_d1_stride = ((4*FpWidth)/AddrWidth)*(((DataW/FpWidth)*x_cols_i
 assign config_d.x_rows_offs = Width*config_d.x_d1_stride;
 assign config_d.w_tot_len   = x_rows_by_w_cols_by_w_rows_iter_q[31:0];
 assign config_d.w_d0_stride = ((4*FpWidth)/AddrWidth)*((DataW/FpWidth) * (config_d.k_size)/(Height*(PipeRegs + 1)));
-assign config_d.yz_tot_len  = Width*x_rows_by_w_cols_iter_q[15:0];
+// Y/Z move one access per (M row, K tile), so the length is m_size*w_cols_iter.
+// Width*x_rows_iter*w_cols_iter counts the trailing M tile as full, which makes the
+// store run past the end of Z by (Width - x_rows_lftovr)*w_cols_iter accesses
+// whenever m_size % Width != 0.
+assign config_d.yz_tot_len  = 32'(config_d.m_size) * 32'(config_d.w_cols_iter);
 assign config_d.yz_d0_stride = config_d.w_d0_stride;
 assign config_d.yz_d2_stride = Width*config_d.w_d0_stride;
 assign config_d.tot_x_read   = x_rows_by_w_cols_by_x_cols_iter_q[31:0];
diff --git a/hardware/deps/redmule/rtl/x_buffer/redmule_x_buffer.sv b/hardware/deps/redmule/rtl/x_buffer/redmule_x_buffer.sv
index 15bd1b4..4cf9d20 100644
--- a/hardware/deps/redmule/rtl/x_buffer/redmule_x_buffer.sv
+++ b/hardware/deps/redmule/rtl/x_buffer/redmule_x_buffer.sv
@@ -271,7 +271,15 @@ always_ff @(posedge clk_i or negedge rst_ni) begin : buf_write_counter
       if ((current_state == PAD_EMPTY || current_state == FAST_FILL && ~first_block) && ctrl_i.h_shift)
         buf_write_cnt <= buf_write_cnt + 1;
       else if (ctrl_i.pad_setup)
-        buf_write_cnt <= ctrl_i.slots;
+        // Prime the double-buffer, not the job: buf_write_cnt tracks how many pad
+        // entries have been drained into the 2-row x_buffer_scm, and pad_setup
+        // pre-loads exactly two rows of H -- the same geometry first_block uses
+        // (pad_r_addr_q == 2*H-1 above). ctrl_i.slots is a JOB size
+        // (H*(NumPipeRegs+1) = TOT_DEPTH), which only equals 2*H when
+        // NumPipeRegs == 1; for any deeper array it desynchronises the FAST_FILL
+        // exit against pad_r_addr_q and every X block is assembled from the wrong
+        // pad entries (silently wrong results, unchanged cycle count).
+        buf_write_cnt <= 2*H;
     end
   end
